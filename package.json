{
  "name": "ai-freelance-marketplace",
  "version": "1.0.0",
  "description": "AI-Freelance Marketplace full-stack app",
  "scripts": {
    "start": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"cyan.bold,magenta.bold\" --prefix \"[{name}]\" \"npm run backend\" \"npm run frontend\"",
    "dev": "npm start",
    "backend": "node run-backend.js",
    "frontend": "npm start --prefix frontend",
    "build:frontend": "npm run build --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
